APP_NAME=Local AI Assistant
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5432/assistant

# AI OpenAI compatible api
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1

# Notion API
NOTION_API_KEY=
NOTION_API_VERSION=2022-06-28

# OpenWeatherMap API
OPENWEATHERMAP_API_KEY=

# Tavily API
TAVILY_API_KEY=

# Todoist API
TODOIST_API_KEY=

# Google OAuth2 (used to refresh Gmail/Calendar access tokens)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# Gmail API
GMAIL_BASE_URL=https://gmail.googleapis.com/gmail/v1

# Google Calendar API
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=Europe/Moscow

# Frontend build-time API URL (for standalone frontend container)
VITE_API_BASE_URL=http://localhost:8000

